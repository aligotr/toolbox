# Зависимости и сборка интерфейса
node_modules/
dist/

# Рабочие файлы приложения: лог живёт рядом с исполняемым файлом,
# то есть в dev-сборке — внутри target. Настройки туда же.
logs/
src-tauri/gen/schemas/

# Portable-сборка, запущенная из корня, пишет данные рядом с собой.
/local/
/profiles/

# Переменные окружения: ключи и локальные настройки.
.env
.env.*

# Местные файлы редакторов и ОС
.vscode/
.idea/
Thumbs.db
Desktop.ini


# ##############################
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt
