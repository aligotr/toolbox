{
  "name": "toolbox",
  "private": true,
  "version": "26.11.0",
  "description": "Платформа для IT-утилит мистера Aligotr.",
  "author": "Aligotr",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import ./tests/support/loader.mjs --test tests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "images:optimize": "node --experimental-strip-types scripts/images-optimizer/images-optimizer.ts",
    "verify": "npm run test && npm run lint && npm run build && npm run docs:check && npm run docs:conformance && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "docs:check": "node .agents/auxiliary/scripts/node/check-docs.mjs",
    "docs:index": "node .agents/auxiliary/scripts/node/build-adr-index.mjs",
    "docs:conformance": "node .agents/auxiliary/scripts/conformance.mjs",
    "clean:target": "node scripts/clean-target.mjs",
    "dev:cdp": "node scripts/dev-cdp.mjs",
    "cdp": "node scripts/cdp.mjs",
    "build": "node scripts/check-zones.mjs && node scripts/check-messages.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "primeicons": "^8.0.2",
    "primevue": "4.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.5"
  }
}
