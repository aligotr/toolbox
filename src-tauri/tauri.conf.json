{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolBox",
  "version": "26.11.0",
  "identifier": "ru.aligotr.toolbox",
  "mainBinaryName": "ToolBox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolBox",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aligotr",
    "shortDescription": "Платформа для IT-утилит мистера Aligotr.",
    "longDescription": "Портативный рабочий стол для сетевых и диагностических задач: DNSlookup, Ping и Busprobe.",
    "copyright": "Copyright © 2026 Aligotr",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
